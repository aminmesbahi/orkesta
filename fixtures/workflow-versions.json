          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
          "id": "edge-scope-gate-capacity",
          "source": "scope-gate",
          "target": "capacity",
          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
          "id": "edge-capacity-implementation",
          "source": "capacity",
          "target": "implementation",
          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
          "id": "edge-implementation-review",
          "source": "implementation",
          "target": "review",
          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
          "id": "edge-review-review-gate",
          "source": "review",
          "target": "review-gate",
          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
          "id": "edge-review-gate-ci",
          "source": "review-gate",
          "target": "ci",
          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
          "id": "edge-ci-release-gate",
          "source": "ci",
          "target": "release-gate",
          "sourceHandle": "output",
          "targetHandle": "context"
        },
        {
